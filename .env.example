# =============================================================
# Leadora AI — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# =============================================================

# ── App ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Database (Neon Serverless PostgreSQL — Free Tier) ────────
# Neon provides 0.5 GB free storage, autoscaling serverless compute!
# Sign up free at: https://neon.tech
# Format: postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# ── Cloudflare R2 Object Storage (Free Tier) ─────────────────
# 10 GB free storage/mo, 10M free reads/mo, 0 egress fees!
# Create bucket in: Cloudflare Dashboard -> R2 -> Create Bucket
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=leadora-assets
R2_PUBLIC_DOMAIN=

# ── NextAuth v5 ───────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=leadora_development_jwt_secret_token_key_32bytes_min_length
AUTH_URL=http://localhost:3000

# ── Google Places API (Optional for Live Discovery) ───────────
# Without key, Leadora uses a realistic high-fidelity local business adapter.
# Get key: https://console.cloud.google.com/apis/library/places-backend.googleapis.com
GOOGLE_PLACES_API_KEY=

# ── Google PageSpeed Insights API (Optional) ──────────────────
# Get key: https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=

# ── Email (SMTP / Resend — Free Tier) ─────────────────────────
# For cold email outreach approval queue
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=resend
SMTP_PASS=
SMTP_FROM=outreach@yourdomain.com

# ── Payment Provider (Stripe — Optional) ──────────────────────
# Without credentials, sandbox checkout simulation is active.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Security & Logs ───────────────────────────────────────────
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef
LOG_LEVEL=info
